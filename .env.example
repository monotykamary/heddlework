[TEMPLATE]
# Heddlework web workspace host — compose environment.
# Copy to .env and fill in what you use. Never commit real keys.

# Required. Exact browser origins allowed to connect (comma-separated).
HEDDLEWORK_HOST_ORIGINS=http://localhost:4817

# Print the fragment pairing URL in container logs (recommended; keep logs private).
HEDDLEWORK_HOST_PRINT_TOKEN=1

# Host port to expose the workspace host on.
HEDDLEWORK_HOST_PORT=4817

# Workspace directory to mount into the container (defaults to the checkout).
#HEDDLEWORK_WORKSPACE=/absolute/path/to/your/project

# Bind-mount ownership: run `id -u` and `id -g` on the host and set them here
# so the container can write the mounted workspace.
#HOST_UID=1000
#HOST_GID=1000

# Optional: initial provider/model handed to Pi at launch.
#HEDDLEWORK_PROVIDER=anthropic
#HEDDLEWORK_MODEL=claude-sonnet-4-5

# Optional: serve a custom OpenAI-compatible endpoint instead of api.openai.com —
# Ollama, LM Studio, vLLM, LiteLLM, a gateway. MODEL is required with BASE_URL.
# The container reaches a server on the host through host.docker.internal on
# Docker Desktop, or the bridge address on Linux (172.17.0.1); passing
# --add-host=host.docker.internal:host-gateway also works.
#HEDDLEWORK_OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#HEDDLEWORK_OPENAI_MODEL=qwen2.5-coder:7b
#HEDDLEWORK_OPENAI_API=openai-completions
#HEDDLEWORK_OPENAI_NAME=custom-openai
#HEDDLEWORK_OPENAI_KEY=
# Optional: HTTP Basic auth, for an endpoint or reverse proxy that asks for a
# username and password instead of a key. Set both together; the pair replaces
# HEDDLEWORK_OPENAI_KEY, since Pi sends Basic through a request header rather
# than an API key. The credential is written to models.json (mode 0600) — to keep
# it out of that file, replace the header value there with a lone $MY_BASIC_HEADER
# and export it into the container instead.
#HEDDLEWORK_OPENAI_USERNAME=
#HEDDLEWORK_OPENAI_PASSWORD=
# The endpoint is probed at startup (GET <base-url>/models, falling back to a
# one-token completion) so a wrong URL, a rejected credential, or an unknown
# model id shows up in the container log. warn (default) logs it and boots
# anyway; require stops the container; off skips the probe.
#HEDDLEWORK_OPENAI_CHECK=warn

# Provider API keys — Pi reads these at runtime; pass only what you use.
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#GEMINI_API_KEY=
#OPENROUTER_API_KEY=
#GROQ_API_KEY=
#XAI_API_KEY=
