{
  "name": "heddlework",
  "version": "0.1.0",
  "description": "A native, harness-neutral workspace for agent sessions, task graphs, diffs, and durable work.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/monotykamary/heddlework.git"
  },
  "bugs": {
    "url": "https://github.com/monotykamary/heddlework/issues"
  },
  "homepage": "https://github.com/monotykamary/heddlework#readme",
  "keywords": [
    "agentic-development",
    "coding-agent",
    "desktop-app",
    "gpuix",
    "pi"
  ],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/main.tsx",
    "start": "bun src/main.tsx",
    "demo": "HEDDLEWORK_DEMO=1 bun --watch src/main.tsx",
    "host": "bun src/host/main.ts",
    "setup:native": "bun scripts/install-gpuix.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc --noEmit -p src/web",
    "test": "bun test ./tests",
    "test:performance": "HEDDLEWORK_PERFORMANCE_BUDGETS=1 bun test ./tests/diff-performance-ui.test.tsx",
    "test:web": "bun test tests/protocol-frames.test.ts tests/protocol-commands.test.ts tests/host-command-replay.test.ts tests/web-sw-policy.test.ts tests/web-host-platform.test.ts tests/web-client-replay.test.ts tests/remote-terminal-service.test.ts tests/host-static-root.test.ts tests/saved-hosts.test.ts tests/web-host-switcher.test.ts && bun scripts/web-dom-e2e.ts",
    "test:browser": "bun scripts/web-browser-probe.ts",
    "check": "bun run typecheck && bun run typecheck:web && bun run test && bun run test:performance && bun scripts/web-dom-e2e.ts",
    "build:web": "bun scripts/build-web.ts",
    "dev:web": "bun scripts/dev-web.ts",
    "build": "bun scripts/build.ts",
    "smoke:browser": "bun scripts/smoke-browser.ts",
    "benchmark:terminal": "bun scripts/benchmark-terminal.ts && bun scripts/benchmark-terminal-ui.tsx",
    "benchmark:terminal:hires": "bun scripts/benchmark-terminal-hires.ts",
    "benchmark:terminal:gpuix": "bun scripts/benchmark-terminal-gpuix.tsx",
    "benchmark:session-switch": "bun scripts/benchmark-session-switch.ts",
    "benchmark:window-metrics": "bun scripts/benchmark-window-metrics.tsx"
  },
  "dependencies": {
    "@gpuix/react": "0.7.0",
    "@mathjax/src": "4.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "happy-dom": "20.14.0",
    "playwright": "1.55.0",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "."
  ]
}
